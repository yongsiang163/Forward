rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Secure User Data Rule:
    // Users can read/write their own profile doc and most subcollections (items,
    // projects) but NOT the `private` subcollection, which holds the Gemini
    // API key and can only be accessed by Admin SDK (Cloud Functions).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /private/{doc=**} {
        allow read, write: if false;
      }

      match /items/{doc=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /projects/{doc=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}