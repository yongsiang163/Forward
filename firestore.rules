rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Secure User Data Rule:
    // 1. Users must be authenticated (request.auth != null)
    // 2. Users can only read/write documents where the document ID matches their UID
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow access to subcollections (items, projects) under the user's document
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}